{
  "id": "login_and_submit_order",
  "name": "登录后下单（顺序复用子流程）",
  "inputs": {
    "username": {
      "required": true
    },
    "password": {
      "required": true,
      "secret": true
    },
    "price": {
      "required": true
    },
    "quantity": {
      "default": "2"
    }
  },
  "steps": [
    {
      "id": "login",
      "type": "call",
      "inputs": {
        "username": "${inputs.username}",
        "password": "${inputs.password}"
      },
      "actionId": "login"
    },
    {
      "id": "submitOrder",
      "type": "call",
      "inputs": {
        "price": "${inputs.price}",
        "quantity": "${inputs.quantity}"
      },
      "actionId": "submit_order"
    }
  ],
  "description": "仅执行操作，不切换当前 Mock；执行前确认起始页面。"
}
