{
  "name": "flutter-pilot",
  "displayName": "Flutter Pilot",
  "description": "Flutter 运行时调试与 Agent 联调工作台：HTTP/WebSocket 采集与 Mock、UI 精确操作、热重载和 MCP。",
  "version": "0.0.7",
  "publisher": "flutter-pilot",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "flutter",
    "dio",
    "mock",
    "proxy",
    "api"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebug:dart",
    "workspaceContains:pubspec.yaml",
    "onCommand:flutterPilot.open"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "启动本地代理及修改开发接入配置需要受信任的工作区。"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "flutterPilot.open",
        "title": "Flutter Pilot: 打开工作台",
        "icon": "$(radio-tower)"
      },
      {
        "command": "flutterPilot.start",
        "title": "Flutter Pilot: 启动代理"
      },
      {
        "command": "flutterPilot.stop",
        "title": "Flutter Pilot: 停止代理"
      }
    ],
    "configuration": {
      "title": "Flutter Pilot",
      "properties": {
        "flutterPilot.enginePath": {
          "type": "string",
          "default": "",
          "description": "可选：本地兼容 mitmdump 的绝对路径。留空则由插件下载和管理。"
        },
        "flutterPilot.proxyPort": {
          "type": "number",
          "default": 8080,
          "minimum": 1024,
          "maximum": 65535,
          "description": "首选代理端口；占用时自动选择可用端口。"
        },
        "flutterPilot.retentionDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 365,
          "description": "请求历史保留天数。"
        },
        "flutterPilot.maxRecords": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "maximum": 100000,
          "description": "历史记录条数上限。"
        },
        "flutterPilot.maxBodyBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "maximum": 10485760,
          "description": "单个正文保存和可编辑的字节上限。"
        },
        "flutterPilot.breakpointTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 300,
          "description": "默认断点等待秒数。"
        },
        "flutterPilot.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "代理模式下，打开受信任的 Flutter 项目后使用已安装引擎后台自动记录，关闭工作台后继续。"
        },
        "flutterPilot.autoConnectVm": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "VM 模式下自动发现本项目的 Flutter Debug 会话，唯一可用会话自动连接并记录 HTTP。Dio Mock、WS 采集和 WS Mock 仍需手动开启。"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:proxy": "python3 -m unittest discover -s tests/proxy -v",
    "test:ui": "playwright test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --out artifacts/flutter-pilot-0.0.7.vsix",
    "test:ide": "node scripts/ide-test.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"webview/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.{mjs,cjs}\" \"*.{json,ts,mts}\"",
    "test:vm": "node scripts/vm-injection-smoke.mjs",
    "test:vm:flutter": "node scripts/vm-flutter-smoke.mjs",
    "test:ide:vm": "node scripts/ide-vm-test.mjs",
    "test:ws": "node scripts/ws-vm-smoke.mjs",
    "test:ws:flutter": "node scripts/ws-flutter-smoke.mjs",
    "test:ui:flutter": "node scripts/ui-flutter-smoke.mjs",
    "test:mcp:flutter": "node scripts/mcp-flutter-smoke.mjs",
    "test:mcp:lifecycle": "node scripts/mcp-lifecycle-flutter-smoke.mjs",
    "test:mcp:agents": "node scripts/mcp-agent-smoke.mjs",
    "test:ide:mcp": "node scripts/ide-mcp-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jsonc-parser": "^3.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.5"
    }
  }
}
